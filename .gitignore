# ---- credentials: NEVER commit ----
# ignore the CONTENTS of accounts/ (real account dirs + tokens), but keep the setup docs.
# (must be accounts/* not accounts/ — a dir-level ignore stops git descending, breaking the negations)
accounts/*
!accounts/.gitkeep
!accounts/default.example
!accounts/README.md

# refresh/id tokens wherever they land
*token*.txt
refresh_token.txt
token.txt

# ---- captured traffic: contains live auth + client data ----
*.har

# ---- output / client data dumps ----
workflows/
reports/
funnels/
mappings/
email_templates/
backup_*.json
*.xlsx
*.csv

# ---- python / misc ----
__pycache__/
*.pyc
.env
.DS_Store

# ---- funnel-builder session scratch (client-specific one-offs, no reuse value) ----
funnel-builder/build_*.py
funnel-builder/mintest*.py
funnel-builder/proof.py
funnel-builder/*_native.json
funnel-builder/patch_*.py

# ghl.sh backup snapshots: real workflow + client data
backups/

# har_index.py output built from YOUR captures (bodies + file names): local only.
# ENDPOINT_INDEX.md (paths only) is the shareable one.
HAR_ENDPOINTS.md
HAR_FILES.md
har/
